# Copy this file to .env and fill in real values. Never commit .env.
# Generate SECRET_KEY / CREDENTIALS_ENCRYPTION_KEY per the commands below —
# do not reuse the examples shown here.

# --- Core ---
APP_ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://hermes:hermes@postgres:5432/hermes_leadgen
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256
# Set to false only for local HTTP development; keep true in any deployed environment.
COOKIE_SECURE=true

# --- Provider credential encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- Optional lead-source connectors (leave blank to keep them "not configured") ---
GOOGLE_PLACES_API_KEY=
PRODUCT_HUNT_API_TOKEN=
GITHUB_TOKEN=

# --- AI provider (OpenAI-compatible endpoint; works with Ollama) ---
# Leave blank to run the MVP fully rule-based / without any AI provider.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

# --- Outreach sending: stays disabled until you explicitly turn it on and
# have verified compliance with CAN-SPAM/GDPR/PECR/applicable law for your
# market (see docs/COMPLIANCE_CHECKLIST.md). MVP ships draft + CSV export only. ---
OUTREACH_LIVE_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Sender identity used in generated outreach copy ---
SENDER_NAME=
SENDER_COMPANY=Hermes Agent Services
SENDER_CONTACT_EMAIL=

# --- Compliance ---
LEAD_DATA_RETENTION_DAYS=730

# --- Research pipeline limits ---
RESEARCH_MAX_PAGES_PER_DOMAIN=5
RESEARCH_REQUEST_TIMEOUT_SECONDS=10
RESEARCH_REQUESTS_PER_DOMAIN_PER_MINUTE=6

# --- Daily workflow ---
DAILY_DISCOVERY_LEAD_LIMIT=25

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Seed / bootstrap owner account (used only by scripts/seed.py on first run) ---
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
