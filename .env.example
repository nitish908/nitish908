# Copy this file to .env and fill in your own credentials.
# NEVER commit a real .env file. Use API keys scoped to trading only —
# disable withdrawal/transfer permissions on exchange keys wherever possible.

# Binance (crypto, via ccxt). Use testnet keys for sandbox=true in config.yaml.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alpaca (stocks). Use paper-trading keys for paper=true in config.yaml.
ALPACA_API_KEY=
ALPACA_API_SECRET=
