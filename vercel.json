{
  "version": 2,
  "builds": [
    { "src": "web/api/backtest.py", "use": "@vercel/python" },
    { "src": "web/api/step.py", "use": "@vercel/python" },
    { "src": "web/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/backtest", "dest": "web/api/backtest.py" },
    { "src": "/api/step", "dest": "web/api/step.py" },
    { "src": "/(.*)", "dest": "web/index.html" }
  ]
}
